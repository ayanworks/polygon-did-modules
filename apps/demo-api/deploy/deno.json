{
  "$schema": "https://raw.githubusercontent.com/denoland/deno/main/cli/schemas/config-file.v1.json",
  "deploy": {
    "project": "polygon-did-playground",
    "entrypoint": "server.ts",
    "include": [],
    "exclude": ["node_modules", "**/*.test.ts"],
    "cache": "auto"
  },
  "tasks": {
    "serve": "deno run --allow-net --allow-read --allow-env server.ts"
  },
  "fmt": {
    "lineWidth": 100,
    "singleQuote": true,
    "semiColons": false
  }
}
